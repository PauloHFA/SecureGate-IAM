{
  "uid": "securegate-postgres",
  "title": "SecureGate PostgreSQL — Operação local",
  "description": "10B2b2b: exporter opcional e estatísticas do cluster. pg_up informa conexão ao banco; up informa scrape HTTP. Não representa capacidade.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "securegate",
    "local",
    "10b2b2b"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Coleta do exporter",
      "type": "stat",
      "description": "up=1 comprova HTTP; conferir também pg_up.",
      "datasource": {
        "type": "prometheus",
        "uid": "securegate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"postgres\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "securegate-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Conexão PostgreSQL",
      "type": "stat",
      "description": "pg_up=0 pode ocorrer com up=1 se a autenticação/conexão SQL falhar.",
      "datasource": {
        "type": "prometheus",
        "uid": "securegate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "pg_up{job=\"postgres\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "securegate-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Conexões no cluster",
      "type": "stat",
      "description": "Conexões de todos os bancos observados, inclui o exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "securegate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends{job=\"postgres\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "securegate-prometheus"
          }
        }
      ]
    },
    {

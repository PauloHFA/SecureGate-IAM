{
  "uid": "securegate-vault",
  "title": "SecureGate Vault — Operação local",
  "description": "10B2b2d: endpoint nativo autenticado; token dedicado de 1h. Contagens incluem monitoração/administração e não representam capacidade ou SLO Transit.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "securegate",
    "local",
    "10b2b2d"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Coleta Vault",
      "type": "stat",
      "description": "Scrape autenticado; 403 pode indicar token expirado/revogado.",
      "datasource": {
        "type": "prometheus",
        "uid": "securegate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"vault\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "securegate-prometheus"
          }
        }
      ]
    },
    {

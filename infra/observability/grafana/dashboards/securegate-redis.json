{
  "uid": "securegate-redis",
  "title": "SecureGate Redis — Operação local",
  "description": "10B2b2c: estatísticas Redis por ACL dedicada sem acesso a chaves. up é scrape HTTP; redis_up é conexão ao Redis. Não representa capacidade.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "securegate",
    "local",
    "10b2b2c"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Coleta do exporter",
      "type": "stat",
      "description": "HTTP disponível; verificar também redis_up.",
      "datasource": {
        "type": "prometheus",
        "uid": "securegate-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponível",
                  "color": "red"
                },
                "1": {
                  "text": "Disponível",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"redis\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "securegate-prometheus"
          }
        }
      ]
    },

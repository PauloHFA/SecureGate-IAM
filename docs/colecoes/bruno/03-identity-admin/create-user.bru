meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrlCore}}/api/admin/users
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bootstrapToken}}
  Content-Type: application/json
}

body:json {
  {
    "username": "demonstration-user",
    "email": "demo@securegate.local",
    "roles": ["OPERATOR"]
  }
}

assert {
  res.status: in [200, 201]
}

# Execute infra/scripts/Initialize-Local.ps1 para gerar .env com valores aleatórios.
# Não use estes placeholders como credenciais.
POSTGRES_DB=securegate
POSTGRES_USER=securegate
POSTGRES_PASSWORD=GENERATED_BY_INITIALIZE_LOCAL
REDIS_PASSWORD=GENERATED_BY_INITIALIZE_LOCAL
RABBITMQ_USER=securegate-local
RABBITMQ_PASSWORD=GENERATED_BY_INITIALIZE_LOCAL
RABBITMQ_VHOST=securegate
VAULT_DEV_ROOT_TOKEN_ID=GENERATED_BY_INITIALIZE_LOCAL

# Bootstrap administrativo temporário; ativação explícita no script de execução.
IAM_BOOTSTRAP_ENABLED=false
IAM_BOOTSTRAP_TOKEN=GENERATED_BY_INITIALIZE_LOCAL

# Portas publicadas somente em 127.0.0.1; ajuste em .env se houver conflito.
POSTGRES_PORT=15432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
VAULT_PORT=8200
